# next-auth's beta declares an OPTIONAL peer range of `nodemailer@^7.0.7 || ^8.0.5`.
# Every nodemailer at or below 9.0.0 carries high-severity advisories (SMTP command
# injection, CRLF header injection, TLS validation), so the only non-vulnerable line
# is 9.0.1+ — outside the range next-auth happens to declare.
#
# The range is metadata, not a real incompatibility: @auth/core's nodemailer provider
# only calls createTransport(server) and sendMail(), then reads result.rejected and
# result.pending. All four are unchanged in 9.x.
#
# Vercel's install command already passes --legacy-peer-deps. Setting it here means
# local installs, CI and the deployment all resolve the same tree instead of three
# different ones. Remove this when a released @auth/core widens the range.
legacy-peer-deps=true
