# Pooled PostgreSQL connection string; carries every query the running app makes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/kalamkari?sslmode=require"

# Unpooled PostgreSQL connection string; used only by `prisma migrate` and `prisma db seed`.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/kalamkari?sslmode=require"

# Secret Auth.js signs session tokens with; generate a fresh one per environment with `npx auth secret`.
AUTH_SECRET=""

# Origin Auth.js builds its callback URLs from; scheme and host only, no path or trailing slash.
NEXTAUTH_URL="http://localhost:3000"

# Public site origin used for canonical tags, Open Graph images, JSON-LD, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth client ID; leave blank to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=""

# Google OAuth client secret; required whenever AUTH_GOOGLE_ID is set.
AUTH_GOOGLE_SECRET=""

# SMTP host for magic-link sign-in and transactional mail; blank prints sign-in links to the console in development.
EMAIL_SERVER_HOST=""

# SMTP port: 587 for STARTTLS, 465 for implicit TLS.
EMAIL_SERVER_PORT="587"

# SMTP username; required whenever EMAIL_SERVER_HOST is set.
EMAIL_SERVER_USER=""

# SMTP password or app password; required whenever EMAIL_SERVER_HOST is set.
EMAIL_SERVER_PASSWORD=""

# From: header on every message the site sends; use an address on your verified sending domain.
EMAIL_FROM="Sri Vijaya Lakshmi Kalamkari <no-reply@example.com>"

# Store inbox that receives new-order, enquiry and commission notifications.
STORE_NOTIFICATION_EMAIL=""

# Razorpay key id for server-side API calls; blank disables online payment and leaves Cash on Delivery.
RAZORPAY_KEY_ID=""

# Razorpay key secret that verifies the browser checkout callback signature.
RAZORPAY_KEY_SECRET=""

# The same Razorpay key id, exposed to the browser so the checkout widget can open.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Separate Razorpay secret that verifies webhook deliveries against the raw request body.
RAZORPAY_WEBHOOK_SECRET=""

# Anthropic API key for the store assistant; blank falls back to the offline knowledge base.
ANTHROPIC_API_KEY=""

# Address that `npm run db:seed` creates as the admin user.
SEED_ADMIN_EMAIL="admin@example.com"

# Base URL that `npm run smoke` drives; never point it at production, it places real orders.
SMOKE_BASE_URL="http://localhost:3000"
