# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default — works with no setup at all)
DATABASE_URL="file:./dev.db"

# PostgreSQL — switch `provider` in prisma/schema.prisma to "postgresql" first.
# DATABASE_URL="postgresql://user:password@localhost:5432/kalamkari?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public origin. Required in production; optional locally.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google sign-in — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Email sign-in (magic links)
# ---------------------------------------------------------------------------
# Leave EMAIL_SERVER_HOST blank in development: sign-in links are printed to the
# server console instead of being sent, so you can log in without an SMTP account.
#
# The same transport carries the transactional mail (order confirmations,
# dispatch notices, enquiry and commission notifications). Nothing is ever
# delivered outside NODE_ENV=production — in development every message is
# printed to the console in full and dropped. See src/lib/mail/transport.ts.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Sri Vijaya Lakshmi Kalamkari <no-reply@example.com>"

# Where store-side notifications go (new orders, enquiries, commissions).
# Optional: falls back to site.contact.email in src/content/site.ts.
STORE_NOTIFICATION_EMAIL=""

# ---------------------------------------------------------------------------
# Payments — Razorpay (placeholder; COD works without these)
# ---------------------------------------------------------------------------
# Without keys, the Razorpay option is disabled in checkout and COD is used.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Webhook signing secret — a different secret from the key above, set when you
# register the endpoint. Point Razorpay at:
#   https://yourdomain/api/razorpay/webhook
# subscribed to payment.captured, order.paid and payment.failed.
#
# Without this the webhook rejects every delivery, and an order whose payer
# closed the tab before the browser callback fired would stay unconfirmed.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Store assistant (Claude)
# ---------------------------------------------------------------------------
# Optional. Without a key the assistant still answers, from the local knowledge
# base in src/content/assistant.ts — it just cannot answer anything unwritten.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# This address is created as an ADMIN user by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
