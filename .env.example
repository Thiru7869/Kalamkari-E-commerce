# Sri Vijaya Lakshmi Fine Kalamkari Arts — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed, so
# every value below is a placeholder and must stay one.
#
# Only DATABASE_URL, DIRECT_DATABASE_URL and AUTH_SECRET are required. Every
# other block is a feature that switches itself off cleanly when left blank —
# so leave optional values as empty strings rather than pasting a dummy value,
# because the code tests whether the variable is set at all.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle by `next build`.
# They are public forever, and changing one needs a rebuild, not a restart.
#
# Full deployment walkthrough: DEPLOYMENT.md


# ---------------------------------------------------------------------------
# Database — PostgreSQL (Prisma)
# ---------------------------------------------------------------------------

# Pooled connection string. Carries every query the app makes. On Neon this is
# the host containing `-pooler`; on a Postgres with no pooler in front of it,
# use the same string as DIRECT_DATABASE_URL below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/kalamkari?sslmode=require"

# Unpooled connection string, used by `prisma migrate` and `prisma db seed`
# only. Migrations hold an advisory lock that a transaction pooler cannot, so
# this must not be the pooled host. It has to exist at build time, because
# `npm run build` runs `prisma migrate deploy`.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/kalamkari?sslmode=require"


# ---------------------------------------------------------------------------
# Authentication — Auth.js v5
# ---------------------------------------------------------------------------

# Signs and encrypts session tokens. Generate a fresh one per environment with
# `npx auth secret`; never reuse the local value in production. Rotating it
# signs everybody out.
AUTH_SECRET=""

# The site's canonical origin, used to build sign-in callback URLs. Scheme and
# host only, no trailing slash. A stale localhost value here in production
# points every magic link at the visitor's own machine.
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client id — optional. The Google button renders only when this
# and the secret below are both set. Register the callback
# `<your-origin>/api/auth/callback/google` in Google Cloud Console first.
AUTH_GOOGLE_ID=""

# Google OAuth client secret. Required whenever AUTH_GOOGLE_ID is set.
AUTH_GOOGLE_SECRET=""


# ---------------------------------------------------------------------------
# Public site URL
# ---------------------------------------------------------------------------

# The origin behind every canonical tag, Open Graph image, JSON-LD block and
# sitemap entry. Read at build time. On Vercel it falls back to the injected
# deployment URL; anywhere else an unset value silently publishes localhost
# URLs into search engines.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ---------------------------------------------------------------------------
# Email — SMTP, for magic links and order mail
# ---------------------------------------------------------------------------

# SMTP hostname, and the switch for this whole block. Blank in development
# prints sign-in links and emails to the terminal instead of sending them;
# blank in production makes email sign-in fail deliberately. Nothing is ever
# delivered outside NODE_ENV=production.
EMAIL_SERVER_HOST=""

# SMTP port. 587 for STARTTLS, 465 for implicit TLS (detected automatically).
EMAIL_SERVER_PORT="587"

# SMTP username. Required whenever EMAIL_SERVER_HOST is set.
EMAIL_SERVER_USER=""

# SMTP password, app password or API key. Server-only secret.
EMAIL_SERVER_PASSWORD=""

# The From: header on everything the site sends. Must be an address on a domain
# verified with the SMTP provider, or the mail is rejected or spam-filed.
EMAIL_FROM="Sri Vijaya Lakshmi Kalamkari <no-reply@example.com>"

# The store's own inbox for new orders, enquiries and commission requests.
# Falls back to `site.contact.email` in src/content/site.ts when blank.
STORE_NOTIFICATION_EMAIL=""


# ---------------------------------------------------------------------------
# Payments — Razorpay (optional; the store runs on Cash on Delivery without it)
# ---------------------------------------------------------------------------

# Razorpay key id. Online payment is offered at checkout only when this and the
# key secret are both present. Test-mode keys locally, live keys in production.
RAZORPAY_KEY_ID=""

# Razorpay key secret. Signs and verifies the checkout callback. Server-only —
# it must never reach the browser.
RAZORPAY_KEY_SECRET=""

# The same value as RAZORPAY_KEY_ID, under a public name, because the browser
# needs it to open the Razorpay widget. A key id is public by design.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# The signing secret you invented when creating the webhook in the Razorpay
# dashboard — not the key secret, and different per environment.
#
# REQUIRED for online payment. Online payment is offered only when the key id,
# key secret AND this are all set; a store with keys but no webhook secret
# would take money and then never hear that a payment cleared after the
# customer closed the tab. Blank means Cash on Delivery only.
RAZORPAY_WEBHOOK_SECRET=""


# ---------------------------------------------------------------------------
# Rate limiting — Upstash Redis (recommended in production)
# ---------------------------------------------------------------------------
#
# Limits on checkout, cart, order tracking, forms, search, sign-in and the
# assistant are counted in a shared Redis so they hold across every serverless
# instance. Create a free Redis database at https://console.upstash.com and
# copy the REST URL and REST token from its page.
#
# Without both, each instance counts on its own: the limits still apply, but a
# determined caller who is spread across instances gets several allowances, and
# the server log says so once per instance. If Redis is configured but
# unreachable, the same per-instance fallback is used — requests are not
# allowed through unlimited, and are not all refused either.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# How many proxies in front of the app append to X-Forwarded-For, so the caller's
# address is read from the right entry rather than from the part the caller
# wrote. 1 is correct on Vercel. Use 2 behind Cloudflare in front of Vercel.
# 0 ignores forwarding headers (every caller then shares one bucket, so use it
# only where no proxy is in front). Blank means 1.
TRUSTED_PROXY_HOPS="1"


# ---------------------------------------------------------------------------
# Store assistant — Anthropic (optional)
# ---------------------------------------------------------------------------

# API key for the assistant's generative replies. Without it the assistant
# still answers, from the offline knowledge base in src/lib/assistant/local.ts,
# so leaving this blank is a legitimate production choice.
ANTHROPIC_API_KEY=""


# ---------------------------------------------------------------------------
# Seeding (read by `npm run db:seed`, not by the running app)
# ---------------------------------------------------------------------------

# The address the seed creates as the ADMIN user, and therefore the only way
# into /admin. Set this to a mailbox you can receive a magic link at before
# seeding a production database.
SEED_ADMIN_EMAIL="admin@example.com"
