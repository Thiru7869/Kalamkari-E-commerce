# dependencies
node_modules/
.pnp
.pnp.js

# next
.next/
out/
build/
next-env.d.ts

# production
dist/

# environment — never commit real keys
# Everything named .env* is ignored, then .env.example is exempted back in.
# The blanket rule matters more than the specific ones: .env.development,
# .env.staging and an ad-hoc .env.render are each one `git add .` away from
# putting a live database password in the history.
.env
.env.*
!.env.example

# database
*.db
*.db-journal
prisma/dev.db
prisma/*.db
prisma/migrations/dev/

# misc
.DS_Store
*.pem
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor
.idea/
.vscode/*
!.vscode/extensions.json

# typescript
*.tsbuildinfo

# vercel
.vercel

# neon cli — records which org the last `neon` command ran against. Local
# state, not project configuration: it is whoever is signed in on this machine.
.neon

# Layout-audit screenshots (scripts/shots.mjs). Generated, never reviewed.
.shots/
